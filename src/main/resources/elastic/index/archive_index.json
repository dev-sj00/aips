{
  "settings" : {
    "index.max_ngram_diff": 10,
    "number_of_shards" : 1,
    "number_of_replicas" : 0,
    "analysis": {
      "analyzer": {
        "autocomplete_analyzer": {
          "tokenizer": "autocomplete_tokenizer",

          "filter": ["lowercase"]
        }
      },
      "tokenizer": {
        "autocomplete_tokenizer": {
          "type": "ngram",
          "min_gram": 1,
          "max_gram": 10,
          "token_chars": ["letter", "digit", "whitespace"]
        }
      }
    }
  },

  "mappings": {
    "properties" : {
      "pk" : {"type" :  "keyword"},
      "title" : {"type" :  "text",
        "copy_to": "auto_complete"
      },

      "topic": {
        "type": "keyword"
      },
      "llmType": {
        "type": "keyword"
      },

      "urlStatus" :  {"type" :  "keyword"},
      "description" : {
        "type":  "text",
        "copy_to": "auto_complete"
      },

      "siteSlug" : {"type" :  "keyword"},
      "createdDateTime" : {"type":  "date", "format":  "strict_date_optional_time||epoch_millis"},
      "userPk": {"type" :  "long"},
      "popularityScore" : {"type" :  "long"},
      "tags": {
        "type": "text",
        "copy_to": "auto_complete"
      },

      "auto_complete": {
        "type": "text",
        "analyzer": "autocomplete_analyzer",
        "search_analyzer": "autocomplete_analyzer",
        "fields": {
          "exact": { "type": "keyword" }
        }
      }

    }
  }
}